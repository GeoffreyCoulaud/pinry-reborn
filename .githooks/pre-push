#!/bin/sh
# The gate, in the container continuous integration runs it in (docs/adr/0024, decision 5).
set -e

# A push that sends no object has nothing to validate: a deletion, which git announces with an
# all-zero local sha, and a tag origin/main already contains (ADR 0030 decision 5, ADR 0031
# decision 8).
sends_objects=""
while read -r local_ref local_sha _rest; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    case "$local_ref" in
        refs/tags/*) git merge-base --is-ancestor "$local_sha" origin/main || sends_objects=yes ;;
        *) sends_objects=yes ;;
    esac
done

if [ -z "$sends_objects" ]; then
    echo "pre-push: nothing but deletions and tags origin/main already contains. No gate."
    exit 0
fi

# The gate reads the working tree, so a dirty one validates something else than HEAD: a `git mv` of
# an edited file once staged the old content and the gate passed on the fixed tree.
if ! git diff HEAD --quiet; then
    echo "pre-push: working tree differs from HEAD (uncommitted changes)." >&2
    echo "Commit or stash first; the gate validates HEAD only on a clean tree." >&2
    exit 1
fi

exec dagger call gate
