#!/bin/sh
# The gate, in the container continuous integration runs it in: the API's build, the repository's
# prose rules and the contract's synchronisation (`.dagger/`, docs/adr/0024 decision 5). Slower than
# the session's warm Gradle daemon, and the last gesture before pushing is where correctness wins.
set -e

# A push that sends no object has nothing to validate, and neither the working tree nor the gate
# bears on it (docs/adr/0030-the-gate-is-paid-where-it-can-fail.md, decision 5, as
# docs/adr/0031-the-gate-builds-once-and-keeps-its-cache.md decision 8 extends it). Two such
# pushes: a deletion, which git announces with an all-zero local sha, and a tag on a commit
# origin/main already contains, which step (e) of Wrap guarantees by tagging a merge. A branch in
# the push, or a tag the remote cannot reach, runs the gate. Git feeds this hook one line per pushed
# reference, "<local ref> <local sha> <remote ref> <remote sha>"; the loop reads standard input
# directly, so what it sets outlives it.
sends_objects=""
while read -r local_ref local_sha _rest; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    case "$local_ref" in
        refs/tags/*) git merge-base --is-ancestor "$local_sha" origin/main || sends_objects=yes ;;
        *) sends_objects=yes ;;
    esac
done

if [ -z "$sends_objects" ]; then
    echo "pre-push: nothing but tags origin/main already contains. No gate."
    exit 0
fi

# The gate reads the working tree; it validates HEAD only when the two match. Refuse the
# push on uncommitted changes, or CI builds commits the local gate never validated (a `git
# mv` of an edited file once staged the old content and the gate passed on the fixed tree).
if ! git diff HEAD --quiet; then
    echo "pre-push: working tree differs from HEAD (uncommitted changes)." >&2
    echo "Commit or stash first; the gate validates HEAD only on a clean tree." >&2
    exit 1
fi

exec dagger call gate
