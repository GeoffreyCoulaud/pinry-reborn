**/build
.kotlin
.gradle
contract/openapi.yaml
*.db
*.db-shm
*.db-wal
# IntelliJ : tout ignorer par defaut...
# Anchored on api/, the project IntelliJ opens: an unanchored .idea/* would stop
# re-including the six shared files below.
api/.idea/*
# ...sauf la config partagee volontairement
!api/.idea/.name
!api/.idea/conventionalCommit.xml
!api/.idea/detekt.xml
!api/.idea/inspectionProfiles/
!api/.idea/ktlint-plugin.xml
!api/.idea/vcs.xml
# A root .idea/ is what an IDE opened on the repository instead of on api/ writes; nothing is
# shared from there. The leading slash keeps this off api/.idea, whose re-inclusions are above.
/.idea/
*.iml
# Claude Code: ignore the personal and generated parts, share the rest.
# settings.json and the hook are team-wide (a hook only on one machine enforces
# nothing); settings.local.json and the worktrees stay local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/CLAUDE.md
# The re-inclusion above takes the whole directory, bytecode cache included.
.claude/hooks/__pycache__/

# Superpowers SDD scratch workspace (task briefs, implementer reports, review packages, progress ledger)
.superpowers/

# Where a review writes its report (docs/adr/0032-a-number-carries-its-source-and-a-report-carries-its-file.md,
# decision 1). Ignored so no closing block's git add can carry a review onto main.
.reviews/
